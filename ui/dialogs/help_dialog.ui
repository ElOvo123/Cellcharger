            </property>
            <property name="text">
             <string>
For research, educational, and laboratory testing of 
lithium-ion cells.

Users are responsible for safe operation and compliance 
with applicable standards.
             </string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

