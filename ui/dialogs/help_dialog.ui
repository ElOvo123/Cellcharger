         <property name="alignment">
          <set>Qt::AlignLeft|Qt::AlignTop</set>
         </property>
         <property name="text">
          <string>
CellCharger is an open-source platform for DCIR and 
capacity characterization of lithium-ion cells.

The system enables controlled charge and discharge
cycles, real-time monitoring, and data logging for
battery performance evaluation.

Developed in collaboration with FST Lisboa to support
Formula Student engineering teams.
          </string>
         </property>
        </widget>
       </item>

